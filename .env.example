# ── Groq API ──────────────────────────────────────────────────────────────────
GROQ_API_KEY=groq_api_key_here
GROQ_MODEL=llama3-70b-8192

# ── GitHub Integration ─────────────────────────────────────────────────────────
# Optional: increases rate limit from 60 to 5000 req/hr
GITHUB_TOKEN=your_github_personal_access_token_here

# ── App Config ─────────────────────────────────────────────────────────────────
MAX_FILE_SIZE_KB=500
MAX_FILES_PER_REVIEW=20
CHUNK_TOKEN_LIMIT=3000
LOG_LEVEL=INFO


RunCMD = py -m streamlit run app.py